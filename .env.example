# MiniStore Environment Configuration Example
# Copy this file to .env and adjust as needed.

# ==========================================
# Store Engine Configuration
# ==========================================

# TCP Interface to bind. Default: 127.0.0.1 (use 0.0.0.0 in Docker)
MINISTORE_HOST=127.0.0.1

# TCP Port to listen on. Default: 6380
MINISTORE_PORT=6380

# Port for the WebSocket Stats Server. Default: 8090
MINISTORE_STATS_PORT=8090

# Maximum bytes an unterminated command line may occupy. Default: 65536
MINISTORE_MAX_LINE_BYTES=65536

# Maximum number of live keys before LRU eviction. Default: 1000
MINISTORE_MAX_KEYS=1000

# Active expiry sweep interval in milliseconds. Default: 1000
MINISTORE_SWEEP_INTERVAL_MS=1000

# Number of keys sampled per sweep. Default: 20
MINISTORE_SWEEP_SAMPLE_SIZE=20

# ==========================================
# Security
# ==========================================

# Password required for TCP clients. Comment out to disable auth.
# MINISTORE_REQUIREPASS=supersecret

# Password required to view the live dashboard. Comment out to disable auth.
# MINISTORE_DASHBOARD_PASSWORD=dashboardsecret

# Comma-separated list of disabled commands.
# Example: FLUSHALL,BGSAVE,BGREWRITEAOF
# MINISTORE_DISABLED_COMMANDS=

# ==========================================
# Persistence & Data
# ==========================================

# Path to the persistence dump file. Default: ./data/dump.json
MINISTORE_DUMP_PATH=/data/dump.json

# Interval in milliseconds to auto-save dump file. Default: 60000
MINISTORE_SAVE_INTERVAL_MS=60000

# Path to the Append-Only File. Default: ./data/appendonly.aof
MINISTORE_AOF_PATH=/data/appendonly.aof

# Fsync policy for AOF: 'always', 'everysec', or 'no'. Default: 'everysec'
MINISTORE_AOF_FSYNC=everysec

# ==========================================
# Environment
# ==========================================

# Set to 'production' to disable verbose logging and enable production defaults.
NODE_ENV=development

# ==========================================
# Dashboard Client Configuration
# ==========================================

# The URL the React dashboard uses to connect to the StatsServer WebSocket.
# Useful if hosting on a different domain/port.
# VITE_WS_URL=ws://localhost:8090
