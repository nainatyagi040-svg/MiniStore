{
  "name": "@ministore/store-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MiniStore engine — TCP server, command parser, in-memory store.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "benchmark": "npm run build && node dist/benchmark/run.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "@ministore/protocol": "*"
  }
}
